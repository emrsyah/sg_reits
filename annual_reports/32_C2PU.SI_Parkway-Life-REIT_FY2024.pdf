   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Modern and trendy background. Fluid abstract design with wave shapes and beautiful color gradient in a paper cut style. This illustration can be used for your design, with space for your text (colors used: Beige, Orange, Gray, Purple, Blue, Black). Vector Illustration (EPS file, well layered and grouped), wide format (2:1). Easy to edit, manipulate, resize or colorize. Vector and Jpeg file of different sizes.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Bgblue - bgblue.com</rdf:li>
    </rdf:Seq>
   </dc:creator>
